# fude's config. Every setting is optional, and fude starts without this
# file. A mistake here shows with its line, and that setting keeps its
# default.

theme = "~/.config/stylix/palette.json"

tab_width = 4
indent_width = 4
color_column = 120
center = true
key_timeout = 500
autocomplete = true
number = true
relative_number = true
wrap = false
scroll_off = 8
ignore_case = true
smart_case = true
expand_tab = true
icons = true
format_on_save = true
format_timeout = 500
clipboard = true
sign_column = true
line_break = true
break_indent = true
virtual_edit = "block"
menu_height = 10
hl_search = false

# The window of fude --gui, in Ghostty's font, which oku.toml's font var
# sets for both.
[gui]
font = ["{{font}}"]
font_size = 16

# What fills the screen where there is no text. eob is the rows past the
# end, blank here as in my Neovim.
[fill_chars]
eob = " "

# A module's options sit in a table named after it. :set takes them as
# module.option, such as :set flash.time 150.
[module.flash]
time = 150

[module.bufferline]
enabled = false

[module.guides]
enabled = false

# Keymaps map keys to keys, in Vim notation. A mapping's keys are never
# mapped again.
[keymap.normal]
"<Leader><Leader>" = ":pick files<CR>"
"<Leader>sg" = ":pick grep<CR>"
"<Leader>sw" = ":pick grep <C-r><C-w><CR>"
"<Leader>sr" = ":pick resume<CR>"
"<Leader>gd" = "<Plug>(git.preview)"

"<C-h>" = "<Plug>(window.left)"
"<C-j>" = "<Plug>(window.down)"
"<C-k>" = "<Plug>(window.up)"
"<C-l>" = "<Plug>(window.right)"

# The names key hints show for the keys mappings start with.
[keymap.groups]
"<Leader>s" = "search"
"<Leader>g" = "git"
"<Leader>d" = "debug"

[keymap.listing]
"<C-h>" = ""
"<C-l>" = ""

# Settings for one filetype. A filetype is a file's extension, or the
# type whose files patterns match its name. lsp names the filetype's
# language servers, whose [lsp.<name>] tables are below. Every one starts.
# The first one that formats or renames does it for the file.
[filetype.go]
lsp = ["gopls", "golangci_lint_ls"]
format = ["goimports", "gofumpt"]

[filetype.bash]
lsp = ["bashls"]

[filetype.fish]
lsp = ["fish_lsp"]

[filetype.c]
lsp = ["clangd"]

[filetype.cpp]
lsp = ["clangd"]

[filetype.json]
lsp = ["jsonls", "biome"]
format = ["biome", "prettierd"]
format_first = true

# jsonc files are json with comments, and the server accepts their comments.
[filetype.jsonc]
lsp = ["jsonls", "biome"]
format = ["biome", "prettierd"]
format_first = true

[filetype.yaml]
lsp = ["yamlls", "gh_actions_ls"]

[filetype.markdown]
lsp = ["marksman"]
format = ["prettierd"]

[filetype.just]
files = ["justfile", "Justfile", ".justfile", "*.just"]
lsp = ["just"]

[filetype.dockerfile]
files = ["Dockerfile", "*.Dockerfile", "Containerfile"]
lsp = ["docker_language_server"]

[filetype.typescript]
lsp = ["vtsls", "eslint", "biome", "tailwindcss"]
format = ["biome", "prettierd"]
format_first = true

[filetype.tsx]
lsp = ["vtsls", "eslint", "biome", "tailwindcss"]
format = ["biome", "prettierd"]
format_first = true

[filetype.javascript]
lsp = ["vtsls", "eslint", "biome", "tailwindcss"]
format = ["biome", "prettierd"]
format_first = true

[filetype.css]
lsp = ["tailwindcss", "biome"]
format = ["biome", "prettierd"]
format_first = true

[filetype.html]
lsp = ["tailwindcss"]

# Templates such as chezmoi's config.toml.tmpl are toml files.
[filetype.toml]
files = ["*.toml.tmpl"]
lsp = ["taplo"]

[filetype.lua]
lsp = ["lua_ls"]

[filetype.nix]
lsp = ["nixd"]

[filetype.rust]
lsp = ["rust_analyzer"]

[filetype.prisma]
lsp = ["prismals"]

# These formatters read the text on stdin and write it on stdout. Each
# runs in the folder of the first root file found, or the file's folder.
# biome runs only in a project with its config, and prettierd elsewhere.
[formatter.goimports]
command = ["goimports", "-srcdir", "{path}"]

[formatter.biome]
command = ["biome", "format", "--stdin-file-path", "{path}"]
root = ["biome.json", "biome.jsonc", ".biome.json", ".biome.jsonc"]
workspace_required = true

[formatter.prettierd]
command = ["prettierd", "{path}"]
root = [
  ".prettierrc",
  ".prettierrc.json",
  ".prettierrc.yml",
  ".prettierrc.yaml",
  ".prettierrc.json5",
  ".prettierrc.js",
  ".prettierrc.cjs",
  ".prettierrc.mjs",
  ".prettierrc.ts",
  ".prettierrc.cts",
  ".prettierrc.mts",
  ".prettierrc.toml",
  "prettier.config.js",
  "prettier.config.cjs",
  "prettier.config.mjs",
  "prettier.config.ts",
  "prettier.config.cts",
  "prettier.config.mts",
  "package.json",
]

# Language servers. fude looks command up on the PATH it starts with, and
# an unset command is the server's name. A server oku installs for one project
# starts only in that project's shell, and elsewhere fude says once that it
# is not installed. root names the files that mark a project's root, most
# wanted first, and fude starts one server per root. settings and
# init_options mean what they do in Neovim's vim.lsp.config.
[lsp.gopls]
root = ["go.work", "go.mod", ".git"]

# golangci-lint itself must be on PATH too. These flags are for its v2.
[lsp.golangci_lint_ls]
command = ["golangci-lint-langserver"]
root = [
  ".golangci.yml",
  ".golangci.yaml",
  ".golangci.toml",
  ".golangci.json",
  "go.work",
  "go.mod",
  ".git",
]
init_options = { command = [
  "golangci-lint",
  "run",
  "--output.text.path=",
  "--output.tab.path=",
  "--output.html.path=",
  "--output.checkstyle.path=",
  "--output.junit-xml.path=",
  "--output.teamcity.path=",
  "--output.sarif.path=",
  "--show-stats=false",
  "--output.json.path=stdout",
] }

[lsp.bashls]
command = ["bash-language-server", "start"]
root = [".git"]

[lsp.fish_lsp]
command = ["fish-lsp", "start"]
root = ["config.fish", ".git"]

[lsp.clangd]
root = [
  ".clangd",
  "compile_commands.json",
  "compile_flags.txt",
  ".clang-tidy",
  ".clang-format",
  "configure.ac",
  ".git",
]

[lsp.jsonls]
command = ["vscode-json-language-server", "--stdio"]
root = [".git"]
init_options = { provideFormatter = true }

[lsp.yamlls]
command = ["yaml-language-server", "--stdio"]
root = [".git"]

[lsp.yamlls.settings]
redhat = { telemetry = { enabled = false } }
yaml = { format = { enable = true } }

# gh_actions_ls is for workflow files only. It fails to start without
# init_options, even empty ones.
[lsp.gh_actions_ls]
command = ["gh-actions-language-server", "--stdio"]
root = [".git"]
files = [
  ".github/workflows/*.yml",
  ".github/workflows/*.yaml",
  ".forgejo/workflows/*.yml",
  ".forgejo/workflows/*.yaml",
  ".gitea/workflows/*.yml",
  ".gitea/workflows/*.yaml",
]
init_options = {}

# eslint and biome start only in a project with their config.
[lsp.eslint]
command = ["vscode-eslint-language-server", "--stdio"]
root = [
  ".eslintrc",
  ".eslintrc.js",
  ".eslintrc.cjs",
  ".eslintrc.yaml",
  ".eslintrc.yml",
  ".eslintrc.json",
  "eslint.config.js",
  "eslint.config.mjs",
  "eslint.config.cjs",
  "eslint.config.ts",
  "eslint.config.mts",
  "eslint.config.cts",
]
workspace_required = true

[lsp.eslint.settings]
validate = "on"
useESLintClass = false
experimental = {}
codeActionOnSave = { enable = false, mode = "all" }
format = true
quiet = false
onIgnoredFiles = "off"
rulesCustomizations = []
run = "onType"
problems = { shortenToSingleLine = false }
nodePath = ""
workingDirectory = { mode = "auto" }
codeAction = { disableRuleComment = { enable = true, location = "separateLine" }, showDocumentation = { enable = true } }
workspaceFolder = { uri = "{root_uri}", name = "{root_name}" }

# 4 lets eslint run the project's own eslint when it asks.
[lsp.eslint.answers]
"eslint/confirmESLintExecution" = 4

# The project's own biome runs first, so it matches its biome.json.
[lsp.biome]
command = [
  [
    "{root}/node_modules/.bin/biome",
    "lsp-proxy",
  ],
  [
    "biome",
    "lsp-proxy",
  ],
]
root = ["biome.json", "biome.jsonc"]
workspace_required = true

[lsp.marksman]
command = ["marksman", "server"]
root = [".marksman.toml", ".git"]

[lsp.just]
command = ["just-lsp"]
root = [".git"]

[lsp.docker_language_server]
command = ["docker-language-server", "start", "--stdio"]
root = [
  "docker-bake.hcl",
  "docker-bake.json",
  "compose.yaml",
  "compose.yml",
  "docker-compose.yaml",
  "docker-compose.yml",
  "Dockerfile",
]

# The lockfiles rank the same, so the nearest one wins in a monorepo.
[lsp.vtsls]
command = ["vtsls", "--stdio"]
root = [
  [
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "bun.lockb",
    "bun.lock",
  ],
  ".git",
]

[lsp.tailwindcss]
command = ["tailwindcss-language-server", "--stdio"]
root = [
  "tailwind.config.js",
  "tailwind.config.cjs",
  "tailwind.config.mjs",
  "tailwind.config.ts",
  "postcss.config.js",
  "postcss.config.cjs",
  "postcss.config.mjs",
  "postcss.config.ts",
  ".git",
]

[lsp.tailwindcss.settings.tailwindCSS]
validate = true
classAttributes = ["class", "className", "class:list", "classList", "ngClass"]
lint = { cssConflict = "warning", invalidApply = "error", invalidScreen = "error", invalidVariant = "error", invalidConfigPath = "error", invalidTailwindDirective = "error", recommendedVariantOrder = "warning" }

# taplo reads the config that lets it check toml templates too.
[lsp.taplo]
command = ["taplo", "lsp", "--config", "~/.config/fude/taplo.toml", "stdio"]
root = [".taplo.toml", "taplo.toml", ".git"]

# The server's own configs rank first, then the linters' and formatters'.
[lsp.lua_ls]
command = ["lua-language-server"]
root = [
  [
    ".emmyrc.json",
    ".luarc.json",
    ".luarc.jsonc",
  ],
  [
    ".luacheckrc",
    ".stylua.toml",
    "stylua.toml",
    "selene.toml",
    "selene.yml",
  ],
  ".git",
]
settings = { Lua = { telemetry = { enable = false } } }

[lsp.nixd]
root = ["flake.nix", ".git"]

# nixd completes nixpkgs and this Mac's darwin options from the system
# flake.
[lsp.nixd.settings.nixd]
nixpkgs = { expr = 'import (builtins.getFlake "{{home}}/nix-system-config-v2").inputs.nixpkgs { }' }

[lsp.nixd.settings.nixd.options]
darwin = { expr = '(builtins.getFlake "{{home}}/nix-system-config-v2").darwinConfigurations."Kyles-MacBook-Air".options' }
flake-parts = { expr = '(builtins.getFlake "{{home}}/nix-system-config-v2").debug.options' }

# A Cargo workspace gets one server, not one for each crate.
[lsp.rust_analyzer]
command = ["rust-analyzer"]
root = [
  { name = "Cargo.toml", contains = [
    "[workspace]",
  ] },
  "Cargo.toml",
  "rust-project.json",
  ".git",
]

[lsp.prismals]
command = ["prisma-language-server", "--stdio"]
root = [".git", "package.json"]

# supermaven plugin -> https://github.com/y3owk1n/fude-supermaven
[[plugin]]
path = "{{home}}/Dev/fude-supermaven/fude-supermaven.wasm"
capabilities = ["buffer.read", "buffer.write", "ui", "process"]
programs = ["sh"]
