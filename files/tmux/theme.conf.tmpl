# Scheme author: Kyle <me@kylewong.my>
# Template author: Tinted Theming: (https://github.com/tinted-theming)

# default statusbar colors
set-option -g status-style "fg=#{{theme.base05}},bg=#{{theme.base00}}"

# default window title colors
set-window-option -g window-status-style "fg=#{{theme.base05}},bg=#{{theme.base00}}"

# active window title colors
set-window-option -g window-status-current-style "fg=#{{theme.base0A}},bg=#{{theme.base00}}"

# pane border
set-option -g pane-border-style "fg=#{{theme.base01}}"
set-option -g pane-active-border-style "fg=#{{theme.base04}}"

# message text
set-option -g message-style "fg=#{{theme.base06}},bg=#{{theme.base01}}"

# pane number display
set-option -g display-panes-active-colour "#{{theme.base04}}"
set-option -g display-panes-colour "#{{theme.base01}}"

# clock
set-window-option -g clock-mode-colour "#{{theme.base0D}}"

# copy mode highlight
set-window-option -g mode-style "fg=#{{theme.base04}},bg=#{{theme.base01}}"

# bell
set-window-option -g window-status-bell-style "fg=#{{theme.base00}},bg=#{{theme.base08}}"

# style for window titles with activity
set-window-option -g window-status-activity-style "fg=#{{theme.base05}},bg=#{{theme.base00}}"

# style for command messages
set-option -g message-command-style "fg=#{{theme.base06}},bg=#{{theme.base01}}"

# Optional active/inactive pane state
# BASE16_TMUX_OPTION_ACTIVE is a legacy variable
if-shell '[ "$TINTED_TMUX_OPTION_ACTIVE" = "1" ] || [ "$BASE16_TMUX_OPTION_ACTIVE" = "1" ]' {
  set-window-option -g window-active-style "fg=#{{theme.base05}},bg=#{{theme.base00}}"
  set-window-option -g window-style "fg=#{{theme.base05}},bg=#{{theme.base00}}"
}

# Optional statusbar
# BASE16_TMUX_OPTION_STATUSBAR is a legacy variable
if-shell '[ "$TINTED_TMUX_OPTION_STATUSBAR" = "1" ] || [ "$BASE16_TMUX_OPTION_STATUSBAR" = "1" ]' {
  set-option -g status "on"
  set-option -g status-justify "left"
  set-option -g status-left "#[fg=#{{theme.base05}},bg=#{{theme.base02}}] #S #[fg=#{{theme.base02}},bg=#{{theme.base00}},nobold,noitalics,nounderscore]"
  set-option -g status-left-length "80"
  set-option -g status-left-style none
  set-option -g status-right "#[fg=#{{theme.base01}},bg=#{{theme.base00}} nobold, nounderscore, noitalics]#[fg=#{{theme.base04}},bg=#{{theme.base01}}] %Y-%m-%d  %H:%M #[fg=#{{theme.base05}},bg=#{{theme.base01}},nobold,noitalics,nounderscore]#[fg=#{{theme.base00}},bg=#{{theme.base05}}] #h "
  set-option -g status-right-length "80"
  set-option -g status-right-style none
  set-window-option -g window-status-current-format "#[fg=#{{theme.base00}},bg=#{{theme.base0A}},nobold,noitalics,nounderscore]#[fg=#{{theme.base01}},bg=#{{theme.base0A}}] #I #[fg=#{{theme.base01}},bg=#{{theme.base0A}},bold] #W#{?window_zoomed_flag,*Z,} #[fg=#{{theme.base0A}},bg=#{{theme.base00}},nobold,noitalics,nounderscore]"
  set-window-option -g window-status-format "#[fg=#{{theme.base00}},bg=#{{theme.base01}},noitalics]#[fg=#{{theme.base06}},bg=#{{theme.base01}}] #I #[fg=#{{theme.base06}},bg=#{{theme.base01}}] #W#{?window_zoomed_flag,*Z,} #[fg=#{{theme.base01}},bg=#{{theme.base00}},noitalics]"
  set-window-option -g window-status-separator ""
}

# vim: set ft=tmux tw=0:
