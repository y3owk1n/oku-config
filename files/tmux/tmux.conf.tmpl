set  -g base-index      1
setw -g pane-base-index 1
# We need to set default-shell before calling new-session
set  -g default-shell "{{data}}/oku/profiles/global/current/bin/fish"

set -g status-keys vi
set -g mode-keys   vi

bind-key -N "Kill the current window" & kill-window
bind-key -N "Kill the current pane" x kill-pane

set  -g mouse             off
set  -g focus-events      on
setw -g aggressive-resize on
setw -g clock-mode-style  12
set  -s escape-time       0
set  -g history-limit     50000

# vim-tmux-navigator, vendored from github.com/christoomey/vim-tmux-navigator
# at e41c431a0c7b7388ae7ba341f01a0d217eb3a432
run-shell {{config}}/tmux/vim-tmux-navigator.tmux

# Colours, from the base16 tmux template of Tinted Theming
source-file {{config}}/tmux/theme.conf

set -g default-terminal "tmux-256color"
set -ga terminal-features ",*:usstyle,*:RGB,*:strikethrough"

bind -N "last-session (via sesh) " L run-shell "sesh last" # overwrite last-session with sesh last

# Modal floating panes, centred. -K sends every key to the pane, as a popup did,
# so vim-tmux-navigator's C-hjkl reach lazygit. allow-set-title off keeps the
# -T title shown in the border. remain-on-exit failed-key keeps a crashed app on
# screen until a key is pressed.
set -g pane-border-status top-floating
set -g pane-border-format " #{pane_title} "
bind C-g new-pane -OK -T "Lazygit" -x 90% -y 80% -X 5% -Y 10% -c "#{pane_current_path}" "lazygit" \; set -p allow-set-title off \; set -p remain-on-exit failed-key
bind C-t new-pane -OK -T "Terminal" -x 90% -y 80% -X 5% -Y 10% -c "#{pane_current_path}" \; set -p allow-set-title off
bind C-d new-pane -OK -T "Friendly" -x 90% -y 80% -X 5% -Y 10% -c "#{pane_current_path}" "friendly" \; set -p allow-set-title off \; set -p remain-on-exit failed-key

# Say when a command of 10s or more finishes in a window I am not looking at.
# Fish sends each OSC 133 end twice, the second with status 0, so only the
# first event for a command start time counts.
set-hook -g pane-command-finished {
  if -F "#{&&:#{e|>=:#{hook_command_duration},10},#{!=:#{hook_command_start_time},#{@notified_start}}}" {
    set -pF @notified_start "#{hook_command_start_time}"
    if -F "#{||:#{!:#{window_active}},#{!:#{session_attached}}}" {
      display-message -d 5000 "#{?#{==:#{hook_command_status},0},done,failed (#{hook_command_status})} in #{session_name}:#{window_index} #{window_name} after #{hook_command_duration}s"
    }
  }
}

set -s clear-on-attach off
set -g pane-scrollbars modal

bind-key -T copy-mode-vi 'v' send -X begin-selection # start selecting text with "v"
bind-key -T copy-mode-vi 'y' send -X copy-selection # copy text with "y"

set -g allow-passthrough on

set -g repeat-time 1000
set -g detach-on-destroy off
set -g renumber-windows on
set -g set-clipboard on
set -g display-time 4000

set -g popup-border-lines rounded

set -g status-interval 5
set -g status-position top
set -g status-justify absolute-centre
set -g status-left "#S #{?client_prefix,,}"
set -g status-right "#H"
set -g status-left-length 30
set -g status-right-length 30

bind-key "C-b" run-shell "sesh connect \"$(
  sesh list --icons | fzf --tmux 80%,70% \
    --no-sort --ansi --border-label ' sesh ' --prompt '⚡  ' \
    --header '  ^a all ^t tmux ^g configs ^x zoxide ^d tmux kill ^f find' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list --icons -t)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list --icons -c)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list --icons -z)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)' \
    --preview-window 'right:55%' \
    --preview 'sesh preview {}' \
    -- --ansi
)\""
